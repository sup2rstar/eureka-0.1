body {
    background-color: #ADD8E6; 
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
}


.main-header {
    width: 100%;
    padding: 20px;
    display: flex;
    justify-content: flex-end;
}

.nav-button {
    background-color: #008080; 
    color: white;
    border: none;
    padding: 10px 20px;
    margin-left: 10px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    text-transform: uppercase;
    transition: background-color 0.3s;
}

.nav-button:hover {
    background-color: #006666; 
}

/* --- Hero Section (Main Content) Styling --- */
.hero-section {
    flex-grow: 1; 
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
}

h1 {
    font-size: 5em;
    color: #008080; 
    margin-bottom: 0.1em;
}

/* FIX FOR IMAGE CIRCLE: This rule uses the .mascot-image class to enforce the size and shape. */
.mascot-image {
    /* Set fixed width and height to force a square area */
    width: 150px;       
    height: 150px;      
    
    /* Makes it a perfect circle */
    border-radius: 50%; 
    
    /* Ensures the image fills the circular area */
    object-fit: cover; 
    background-color: #008080; 
    margin: 20px 0;
    display: block; 
}

/* STYLING FOR THE TAGLINE TEXT */
.tagline {
    color: #008080; 
    font-family: 'Times New Roman', serif; 
    font-size: 1.2em;
    font-style: italic;
    margin-top: 5px;
}
